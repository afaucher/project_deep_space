@rpc("any_peer", "call_local")
func request_spawn(type: String) -> void:
	if not is_multiplayer_authority(): return
	var main = get_node_or_null("/root/Main")
	if not main: return
	
	if type == "asteroids":
		main._spawn_asteroids()
	elif type == "drone":
		main._spawn_drone()
	elif type == "friendly_drone":
		main._spawn_drone(true)
	elif type == "buoy":
		main._spawn_buoy()

